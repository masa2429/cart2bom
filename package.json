{
  "name": "cart2bom",
  "version": "0.5.4",
  "private": true,
  "description": "複数通販サイトのカートを保存・共有可能な部品リストへ変換するUserScript",
  "author": "morita_masato",
  "license": "MIT",
  "homepage": "https://github.com/masa2429/cart2bom",
  "repository": {
    "type": "git",
    "url": "https://github.com/masa2429/cart2bom.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --development",
    "build:pages": "node scripts/build-pages.mjs",
    "build:all": "npm run build && npm run build:pages",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
